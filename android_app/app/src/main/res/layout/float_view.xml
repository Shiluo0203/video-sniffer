<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F01F2430"
    android:padding="8dp">

    <!-- 顶部：拖拽条 + 刷新 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:background="#3a4152" />

        <TextView
            android:id="@+id/float_refresh_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="↻"
            android:textSize="15sp"
            android:textColor="#9aa3b5" />

        <TextView
            android:id="@+id/float_close_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="×"
            android:textSize="16sp"
            android:textColor="#e6e9ef" />
    </LinearLayout>

    <!-- 识别到的链接标题 -->
    <TextView
        android:id="@+id/float_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✓ 服务运行中\n复制视频链接后点 ↻ 读取"
        android:textColor="#e6e9ef"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/float_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@android:drawable/progress_horizontal" />

    <TextView
        android:id="@+id/float_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#9aa3b5"
        android:textSize="10sp" />

    <!-- 下载按钮 -->
    <TextView
        android:id="@+id/float_download_btn"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:background="#3d6fd6"
        android:gravity="center"
        android:text="立即下载"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:enabled="false" />

</LinearLayout>
